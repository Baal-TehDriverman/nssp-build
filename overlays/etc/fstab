# /etc/fstab - NSSP Lilith OS
# Generated by mkosi/nssp-build

# <file system>  <dir>  <type>  <options>  <dump>  <pass>
/dev/nvme0n1p1  /boot/efi  vfat  rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro  0  2

# Btrfs root with subvolumes (mounted by systemd based on PARTUUID)
# Root subvolume @
UUID=ROOT_UUID  /  btrfs  rw,relatime,compress=zstd:3,space_cache=v2,subvol=@  0  0

# Home subvolume @home
UUID=ROOT_UUID  /home  btrfs  rw,relatime,compress=zstd:3,space_cache=v2,subvol=@home  0  0

# Snapshots
UUID=ROOT_UUID  /.snapshots  btrfs  rw,relatime,compress=zstd:3,space_cache=v2,subvol=@snapshots  0  0

# Var subvolumes
UUID=ROOT_UUID  /var/log  btrfs  rw,relatime,compress=zstd:3,space_cache=v2,subvol=@var_log  0  0
UUID=ROOT_UUID  /var/cache  btrfs  rw,relatime,compress=zstd:3,space_cache=v2,subvol=@var_cache  0  0

# Opt and srv
UUID=ROOT_UUID  /opt  btrfs  rw,relatime,compress=zstd:3,space_cache=v2,subvol=@opt  0  0
UUID=ROOT_UUID  /srv  btrfs  rw,relatime,compress=zstd:3,space_cache=v2,subvol=@srv  0  0

# Lilith Dashboard data
UUID=ROOT_UUID  /home/tehlappy/🜏 Lilith/ONE FUCKING DASHBOARD  btrfs  rw,relatime,compress=zstd:3,space_cache=v2,subvol=@lilith  0  0

# Swap on zram
/dev/zram0  none  swap  defaults,pri=100  0  0

# Temporary files
tmpfs  /tmp  tmpfs  rw,nosuid,nodev,size=50%  0  0